<linker>
  <!-- Preservar Raylib-cs y sus P/Invokes para evitar trimming en NativeAOT -->
  <assembly fullname="Raylib-cs">
    <type fullname="*" preserve="all" />
  </assembly>
  <!-- Preservar tipos y métodos en GraviSharp.UI y GraviSharp.Core -->
  <assembly fullname="GraviSharp.UI">
    <type fullname="*" preserve="all" />
  </assembly>
  <assembly fullname="GraviSharp.Core">
    <type fullname="*" preserve="all" />
  </assembly>
</linker>
